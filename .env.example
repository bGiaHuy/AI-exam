# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==============================================================================
# SPRINT 3.2: DUAL-CAMERA MONITORING MODE CONFIGURATION
# ==============================================================================
# Active camera runtime mode: SINGLE_CAMERA (legacy default) or DUAL_CAMERA
CAMERA_MODE="SINGLE_CAMERA"

# Camera 1 Configuration (Góc trước / Front Angle)
# Transport types: browser_ws | usb | rtsp | synthetic
CAMERA_1_TYPE="browser_ws"
CAMERA_1_LABEL="Camera 1 (Góc trước)"
CAMERA_1_DEVICE_INDEX="0"
# NOTE: Replace placeholder with your local camera credentials. NEVER commit raw passwords to git!
CAMERA_1_RTSP_URL="rtsp://<camera_user>:<camera_password>@192.168.1.101:554/stream1"
CAMERA_1_FPS="15.0"

# Camera 2 Configuration (Góc bên / Side Angle / Desk View)
# Transport types: browser_ws | usb | rtsp | synthetic
CAMERA_2_TYPE="browser_ws"
CAMERA_2_LABEL="Camera 2 (Góc bên)"
CAMERA_2_DEVICE_INDEX="1"
# NOTE: Replace placeholder with your local camera credentials. NEVER commit raw passwords to git!
CAMERA_2_RTSP_URL="rtsp://<camera_user>:<camera_password>@192.168.1.102:554/stream1"
CAMERA_2_FPS="15.0"

