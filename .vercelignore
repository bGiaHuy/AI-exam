# ================================================================================
# VERCEL DEPLOYMENT IGNORE LIST
# ================================================================================
# Strictly prevents any proprietary backend code, AI models, datasets, database,
# evidence media, training lineage, or internal documentation from being uploaded.
# ================================================================================

# Version Control & CI/CD
.git/
.github/
.agents/
archive/

# Environment, credentials & local configs
.env
.env.*
*.pem
*.key
*.cert
*.crt

# Python runtime, backend code & environments
.venv/
backend/
**/__pycache__/
*.py[cod]
*$py.class
openh264*.dll

# AI Models, Weights, and Architectures
model/
models/
weights/
*.pt
*.onnx
*.engine
*.pth
*.bin
*.pkl

# Datasets, Labels & Evidence media
dataset/
datasets/
data/
evidence/
*.mp4
*.avi
*.mov
*.mkv
*.jpg
*.jpeg
*.png

# SQLite Databases & WAL journal files
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Archives, Zips & Deliverables
*.zip
*.tar
*.gz
*.7z

# Internal Research Reports, Benchmarks & Guides
reports/
handoff/
handoffv2/
handoffv3/
scratch/
scripts/
nasm_demo/
*.docx
*.pdf
DOCUMENTATION.md
